# Copia a .env (gitignored y bloqueado a lectura para el agente). Una key por persona si es posible.
ANTHROPIC_API_KEY=sk-ant-...
# Proveedor: anthropic (SDK oficial, ANTHROPIC_API_KEY) u openai_compat (gateway /v1/chat/completions con tools).
# Helmcode (crédito del hackathon): openai_compat + base URL + key. Sus modelos claude-* van con crédito aparte (402).
ALBERTITOS_LLM_PROVEEDOR=openai_compat
ALBERTITOS_LLM_BASE_URL=https://api.helmcode.com/v1
ALBERTITOS_LLM_API_KEY=sk-hke_...
# Modelo de extracción (texto) y de visión (29 escaneadas). Probados en Helmcode: deepseek-v4-flash (texto) y qwen3.6 (visión).
ALBERTITOS_MODELO_TEXTO=deepseek-v4-flash
ALBERTITOS_MODELO_VISION=qwen3.6
# Modelo de respaldo por camino (opcional). Si el principal agota sus reintentos o el circuit
# breaker está abierto, se intenta UNA vez el de respaldo, con clave de caché propia, y el evento
# dice qué modelo respondió. Vacío = la degradación es dejar PENDIENTE (sin hechos no hay decisión).
# Medido el 18/09/2026 contra Helmcode: glm5.3-flash responde con tool call y acierta en TEXTO.
# En VISIÓN ningún modelo lee el NIF de forma fiable: el respaldo da disponibilidad, no precisión.
ALBERTITOS_MODELO_TEXTO_FALLBACK=glm5.3-flash
ALBERTITOS_MODELO_VISION_FALLBACK=
# Límite de gasto por ejecución en EUR: el cliente LLM se niega a superarlo.
ALBERTITOS_PRESUPUESTO_EUR=5
# Proveedor de respaldo (opcional). Si está vacío, la degradación es dejar PENDIENTE.
ALBERTITOS_FALLBACK_API_KEY=
# Tarifa por modelo, EUR por millón de tokens [entrada, salida]. Los modelos ABIERTOS de Helmcode
# (deepseek-v4-flash, qwen3.6, glm5.3-flash, gemma4) NO se pagan por token: la suscripción es plana
# por key, así que van a 0 en el código. Sólo hace falta esto si se usa un modelo de pago.
# ALBERTITOS_PRECIOS_JSON={"claude-sonnet-5": [2.7, 13.5]}
# Respaldo para modelos que no estén en la tabla ni en el JSON de arriba:
ALBERTITOS_PRECIO_IN_EUR_MTOK=3
ALBERTITOS_PRECIO_OUT_EUR_MTOK=15
# ERP local
ALBERTITOS_ERP_URL=http://127.0.0.1:8009
# BD SQLite (WAL). Por defecto dist/albertitos.db
ALBERTITOS_DB=dist/albertitos.db
# Fecha de corte para "fecha no futura" (nunca date.today()). ISO.
ALBERTITOS_FECHA_CORTE=2026-09-18
# Repo público de entrega (3 ficheros en raíz). owner/nombre
ENTREGA_REPO=javiersaguar/la-caja-outcomes
